[MESH]
filename = bc_2d.msh

[FINITE ELEMENT SPACE]
elements = u_c     -> HDiv
           u_d     -> HDiv
           p       -> L2
           alpha_c -> L2
interpolant_order = 3

[DG]
DG = True
interior_penalty_coefficient = 10.0

[SOLVER]
linear_solver            = direct
preconditioner           = default
linearization_method     = Picard
nonlinear_solver         = default
nonlinear_tolerance      = relative -> 1e-5
                           absolute -> 1e-5
nonlinear_max_iterations = 10
relaxation_factors       = 1.0, 1.0, 1.0, 1.0

[TRANSIENT]
transient  = True
scheme     = implicit euler
time_range = 0.0, 3.0
dt         = 2e-3

[VISUALIZATION]
save_to_file   = True
save_type      = .vtu
save_vtu_each_timestep = True
save_frequency = 5, numit

[OTHER]
num_threads            = 6
model                  = TwoFluidModel
run_dir                = .
slope_limiter          = True
diffusion_switch       = True

[TFM]
canonical_form         = C-TFM
IME                    = drag               -> Tomiyama
                         lift               -> Tomiyama
                         virtual_mass       -> ConstantCoefficient
                         laminar_dispersion -> ConstantCoefficient
lift_wall_deactivation = True
lift_wall_boundaries   = wall|bottom
