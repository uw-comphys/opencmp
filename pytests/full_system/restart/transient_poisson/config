[MESH]
filename = pytests/mesh_files/unit_square_coarse.vol

[DIM]
diffuse_interface_method = False

[FINITE ELEMENT SPACE]
elements = u -> H1
interpolant_order = 3

[DG]
DG = False
interior_penalty_coefficient = 10.0

[SOLVER]
linear_solver = default
preconditioner = default

[TRANSIENT]
transient = True
scheme = implicit euler
time_range = 0.0, 0.1
dt = 1e-2
dt_tolerance = relative -> 1e-5
               absolute -> 1e-7
dt_range = 1e-8, 0.01

[VISUALIZATION]
save_to_file = True
save_type = .sol
save_frequency = 1, numit

[ERROR ANALYSIS]
check_error = False

[OTHER]
num_threads = 1
model = Poisson
run_dir = .
resume_from_previous = False
